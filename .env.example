# Frontend environment variables
# Copy this file to `.env`. Never commit the real `.env` file.

# Backend API base URL (must end with /api)
# Local development (backend started with `npm run dev` on port 5000):
VITE_API_BASE_URL=http://localhost:5000/api

# Production example - use your own deployed backend:
# VITE_API_BASE_URL=https://your-backend-domain.example.com/api
